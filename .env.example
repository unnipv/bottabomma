# Google Sheets Configuration
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json
GOOGLE_SHEET_NAME=your_sheet_name_here

# WhatsApp Group Configuration  
# To find group ID: bot will log all group IDs on startup
TARGET_GROUP_ID=your_group_id_here

# Groq API (free tier - for better title/keyword extraction)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Catch-up Configuration
CATCHUP_MESSAGE_COUNT=100

# Catbox.moe Configuration (optional - for managing/deleting uploads later)
# Create account at https://catbox.moe and get userhash from https://catbox.moe/user/manage.php
CATBOX_USERHASH=

# Logging
LOG_LEVEL=info
