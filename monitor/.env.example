# HTTP server
MONITOR_HOST=127.0.0.1
MONITOR_PORT=3010

# Recommended if you will expose this via Cloudflare Tunnel or any reverse proxy.
MONITOR_USERNAME=admin
MONITOR_PASSWORD=change-me

# PM2 process to inspect
MONITOR_TARGET_NAME=bottabomma

# Optional fallback if the bot is not under PM2
# BOT_LOG_FILE=/home/pi/.pm2/logs/bottabomma-out.log

# Dashboard tuning
MONITOR_LOG_LINES=120
MONITOR_DISK_PATH=/

# ngrok local agent API
NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
